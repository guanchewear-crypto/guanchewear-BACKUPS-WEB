{
  "name": "guanchewear-landing",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify": "npm run lint && npm run build && npm run verify:catalog && npm run verify:anchors && npm run verify:order && npm run verify:import && npm run verify:origin && npm run verify:grid",
    "verify:catalog": "node scripts/verify-garments.mjs",
    "verify:anchors": "node scripts/verify-anchors.mjs",
    "verify:order": "node scripts/verify-order-message.mjs",
    "verify:import": "python scripts/verify-import.py",
    "verify:origin": "python scripts/verify-origin-map.py",
    "verify:grid": "python scripts/check-gallery-grid.py"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lighthouse": "^13.4.1",
    "lucide-react": "^1.28.0",
    "puppeteer-core": "^25.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
